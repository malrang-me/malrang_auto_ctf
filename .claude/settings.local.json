{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(*)",
      "mcp__filesystem__*",
      "mcp__py-repl__*",
      "mcp__pwn-local__*",
      "mcp__solver-z3__*",
      "mcp__solver-pysat__*",
      "mcp__solver-cryptominisat__*",
      "mcp__sage-helper__*",
      "mcp__github__*",
      "WebSearch(*)",
      "WebFetch(*)"
    ]
  },
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check_completion.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "docker",
    "filesystem",
    "github",
    "ida-pro-mcp",
    "notion",
    "pwn-local",
    "solver-z3",
    "py-repl",
    "solver-pysat",
    "sage-helper",
    "solver-cryptominisat"
  ]
}
