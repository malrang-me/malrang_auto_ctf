{
  "permissions": {
    "allow": [
      "Bash(*)",
      "mcp__filesystem__*",
      "mcp__py-repl__*",
      "mcp__pwn-local__*",
      "mcp__solver-z3__*",
      "mcp__solver-pysat__*",
      "mcp__solver-cryptominisat__*",
      "mcp__sage-helper__*",
      "mcp__github__*",
      "WebSearch(*)",
      "WebFetch(*)",
      "Skill(progress)",
      "Skill(progress:*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "enabledMcpjsonServers": [
    "docker",
    "filesystem",
    "github",
    "ida-pro-mcp",
    "notion",
    "pwn-local",
    "solver-z3",
    "py-repl",
    "solver-pysat",
    "sage-helper",
    "solver-cryptominisat"
  ],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo C:/Users/malrangme/Desktop/malrang_auto_ctf) && bash \"$ROOT/.claude/hooks/post_solve_learn.sh\"'",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo C:/Users/malrangme/Desktop/malrang_auto_ctf) && bash \"$ROOT/.claude/hooks/check_completion.sh\"'",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash -c 'ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo C:/Users/malrangme/Desktop/malrang_auto_ctf) && bash \"$ROOT/.claude/hooks/post_solve_learn.sh\"'",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash -c 'ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo C:/Users/malrangme/Desktop/malrang_auto_ctf) && bash \"$ROOT/.claude/hooks/validate_handoff.sh\"'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
